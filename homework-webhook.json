{
  "name": "NS04 - Webhook → Telegram → Таблица",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "new-lead",
        "responseMode": "onReceived",
        "responseCode": 200
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "Новая заявка!\n\nИмя: {{ $json[\"query\"][\"name\"] }}\nEmail: {{ $json[\"query\"][\"email\"] }}\nТелефон: {{ $json[\"query\"][\"phone\"] }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "telegram-node",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "telegramApi": {
          "id": "telegram-credential-id",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.BPIUM_DOMAIN }}.bpium.ru/api/v1/catalogs/{{ $env.BPIUM_CATALOG_ID }}/records",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"values\": {\n    \"2\": $json[\"query\"][\"name\"],\n    \"3\": $json[\"query\"][\"email\"],\n    \"4\": $json[\"query\"][\"phone\"]\n  }\n}) }}",
        "options": {}
      },
      "id": "bpium-node",
      "name": "Бипиум",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [750, 300],
      "credentials": {
        "httpBasicAuth": {
          "id": "bpium-credential-id",
          "name": "Бипиум Auth"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram": {
      "main": [
        [
          {
            "node": "Бипиум",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "homework-ns04"
  },
  "tags": [
    {
      "name": "homework",
      "id": "homework-tag-id"
    }
  ]
}
